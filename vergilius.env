# Vergilius — impostazioni dell'assistente (valgono su QUALSIASI macchina)
# ============================================================================
# Letto da boot/vergilius_boot.py e passato a Odysseus. Sono scelte di
# orchestrazione e di ancoraggio ai dati: dipendono dal fatto che il modello
# sia piccolo e locale, NON dalla scheda video. Chi clona il progetto le tiene
# così. Le impostazioni legate all'hardware stanno in `vergilius-hardware.env`.
#
# Righe `NOME=valore`, commenti con `#`. Una variabile già presente
# nell'ambiente di sistema vince su questo file.
#
# Misure alle spalle di ogni riga: ricerche/opt-1080/41 e 42.
# Riferimento: 12 casi agentici Financial x3, istanza di prova, GTX 1080.

# --- Modello -----------------------------------------------------------------
# Profilo di leve per il modello predefinito: carica vergilius-<nome>.env DOPO questo file
# e dopo vergilius-hardware.env. `lfm` = LFM2.5-2.6B (predefinito dal 19 set 2026).
# Vuoto = nessun profilo: valgono le leve qui sotto, tarate sul modello precedente (MoE da 7,9B).
VERGILIUS_MODELLO=lfm

# --- Orchestrazione del giro con strumenti -----------------------------------
# Congela per sessione la lista di strumenti inviata al modello. Senza, la
# lista cambia a ogni turno (RAG dei tool + policy per intento) e il prefisso
# in cache va buttato ogni volta. Turno mediano 122 -> 90 s.
ODYSSEUS_TOOLSET_FREEZE=1

# Tetto al ragionamento SOLO nei giri in cui gli schemi sono attaccati (quelli
# in cui il modello sceglie lo strumento). Dal 27 set 2026 e' solo una rete
# contro i ragionamenti infiniti (2048), non un taglio: tagliare il pensiero
# mentre il modello sceglie lo strumento lo fa rispondere in inglese e rifare
# chiamate (misure in vergilius-lfm.env). Storia: con il modello precedente 128
# portava il giro con tool da 57 a 24 s (baseline 56-106 s di pensiero per una
# chiamata da 900 byte; banco da 526 casi 80,4% contro 79,9%).
ODYSSEUS_TOOL_ROUND_REASONING_BUDGET=2048
# Testo in inglese (lo legge il modello) e frase compiuta: llama.cpp lo incolla dove
# il pensiero si interrompe, quindi l'a-capo lo mette il codice (_reasoning_budget_message).
ODYSSEUS_TOOL_ROUND_REASONING_MESSAGE=Enough thinking. Act now.

# Tetto ai token generati quando il preset non ne impone uno: senza, per
# llama.cpp "0" significa infinito e un giro è finito in timeout a 300 s.
ODYSSEUS_AGENT_MAX_TOKENS_CAP=4096

# --- Riuso della cache del prompt --------------------------------------------
# La storia viene rigiocata IDENTICA a come fu inviata (contesto data/ora dov'era,
# chiamate, output degli strumenti, testo utente con le note in coda). Le memorie
# recuperate vanno in fondo, non in testa: il loro contenuto cambia a ogni turno e
# in testa rompeva il prefisso dopo 8429 token. Con queste due, al quarto turno si
# riusano 34k token invece di 8,4k.
ODYSSEUS_HISTORY_REPLAY=1
ODYSSEUS_MEMORY_TAIL=1

# Stesso limite di caratteri per l'output di uno strumento dentro il turno e nella
# storia: se differiscono, il messaggio in cache e quello rigiocato non coincidono
# e il turno precedente si riprocessa sempre. Turno mediano 68 -> 55 s, p95 73 s.
# Alzarli entrambi (mantenendo storia > turno) se le risposte risultano troncate.
ODYSSEUS_TOOL_OUTPUT_CHARS=3000
ODYSSEUS_HISTORY_TOOL_CHARS=3300

# --- Ancoraggio ai dati (anti-invenzione) ------------------------------------
# Quattro righe statiche in coda al prompt di sistema: mai inventare numeri,
# i dati freschi vengono dagli strumenti, se manca il dato dillo.
ODYSSEUS_GROUNDING_RULES=1

# Domanda che chiede un dato fresco (oggi, ultime, prezzo, notizie, chi guida X,
# borsa...) + almeno uno strumento di dati fra quelli inviati -> la chiamata al
# primo giro è garantita dalla grammatica. Non cambia la lista di strumenti,
# quindi non tocca la cache. Misurato: 36 scatti su 36 domande fresche, zero
# falsi positivi sulle 12 domande da conoscenza pura.
ODYSSEUS_FRESH_REQUIRED=1

# Se la risposta finale contiene numeri che non compaiono in nessun output degli
# strumenti del turno, o nomina un'entità di cui nessuno strumento parla, un solo
# rilancio: "riscrivi usando solo i dati dei tool; se il dato manca, dillo".
# Turni con cifre non supportate: 3/35 -> 1/36.
ODYSSEUS_GROUNDING_RETRY=1

# Riga `[grounding]` nel log a fine turno (numeri e entità non supportati).
# Costa nulla e serve a sapere se il problema torna. Mettere a 0 per silenziare.
ODYSSEUS_GROUNDING_CHECK=1

# --- Sicurezza: indice delle skill --------------------------------------------
# L'indice delle skill scritte QUI (source user/learned) entra nel contesto come contenuto di casa
# e non arma il filtro "contesto esterno non fidato". Le skill importate da URL e quelle di
# provenienza non dimostrabile restano non fidate. Senza questa riga basta una skill salvata
# perche' bash e la scrittura dei documenti chiedano un'approvazione in ogni chat.
ODYSSEUS_SKILLS_INDEX_TRUSTED=1
# Provenienze in piu' dichiarate fidate dal proprietario. `community` = le 13 skill prese dal
# pacchetto pubblico pm-claude-skills, scelte, adattate e installate a mano il 31 lug 2026.
# Il campo `source` delle skill resta quello vero: la fiducia si dichiara qui, non li'.
# `imported` (import da URL) non e' mai accettata, nemmeno se la scrivi.
# 27 set 2026: tolta dopo l archivio delle 13 skill community (stanza 3 passo 2, politica del proprietario: fidate solo le skill che passano l harness)
# ODYSSEUS_SKILLS_TRUSTED_SOURCES=community

# --- Primo avvio -------------------------------------------------------------
# Al primo accesso la schermata propone admin/admin gia' compilati, cosi' si entra
# con un clic. Serve una soglia piu' bassa degli 8 caratteri di default. Vergilius
# ascolta su 127.0.0.1: se lo esponi in rete, alza questo valore e cambia password.
ODYSSEUS_PASSWORD_MIN_LENGTH=5

# --- Misurate e NON adottate --------------------------------------------------
# ODYSSEUS_TOOL_DEDUP=1        chiamate identiche nello stesso turno: 0 casi reali
# ODYSSEUS_TOOL_CACHE_TTL=900  chiamate identiche nella sessione: 0 casi reali
#   (su 26 chiamate consecutive, zero coppie con gli stessi argomenti: il modello
#    varia sempre almeno un parametro)

# Riflessi (26 set 2026). Mappa: luogo del dizionario POSTI + intento mappa esplicito = centratura prima del
# giro di LFM, sola vista, senza approvazione (decisione del proprietario). 0 = spento.
ODYSSEUS_RIFLESSI_MAPPA=1

# --- 27 set 2026: leve nuove, tutte SPENTE finche' una misura non dice di accenderle ---
# Stanza 3 (biblioteca di skill, selettore stile R3-Skill). Referto e piano: D:\vergilius-lab\chatroom\stanza3-biblioteca-skill\
ODYSSEUS_SKILL_SELETTORE=0
ODYSSEUS_SKILL_SELETTORE_SOGLIA=0.8
ODYSSEUS_SKILL_SELETTORE_MAX=2
ODYSSEUS_SKILL_SELETTORE_SLOT=2
ODYSSEUS_SKILL_SELETTORE_TETTO=0.8
ODYSSEUS_SKILL_SELETTORE_NESSUNA_PRIMA=0
ODYSSEUS_BENCH_SKILL_FIELD=0
# ODYSSEUS_BROWSER_TESTO_MAX=7400   (vuota = 9000; si misura al passo 4 del piano)
# Stanza 1 (varco): vuote = comportamento di oggi. Si accendono insieme dopo il conteggio delle schede nelle suite.
# ODYSSEUS_MEMORY_GATE_TRUSTED_SOURCES=user
# ODYSSEUS_MEMORY_EXTRACT_USER_ONLY=1
# ODYSSEUS_CHAT_GRANT_SCOPE=effetti
# ODYSSEUS_GATE_REPLAY_TAINT=1
# Fuori scope delle stanze: vuote = oggi.
# ODYSSEUS_DEFAULT_TEMPERATURE=0.1   (oggi 1.0 senza preset; decide la misura del punto 3)
# ODYSSEUS_VISTA_JPEG_QUALITY=90     (oggi PNG; decide il banco "occhio decide")
# ODYSSEUS_VISTA_ID_SLOT=0           (oggi nessuno slot fisso per Holo)
# Decisione del proprietario (27 set 2026, pomeriggio): il modello NON si costruisce skill da solo; fidate sono solo le
# skill della biblioteca che passano l'harness (verifica-skill + banco del selettore + A/B per famiglia). Stanza 4, voce A2.
ODYSSEUS_SKILL_LEARNED_FIDATA=0
ODYSSEUS_SKILL_ESTRAZIONE_AUTO=0
ODYSSEUS_SKILL_MODELLO_SCRIVE=0
# Stanza 4, leve nuove spente: ODYSSEUS_PC_APP_FIDATE= (processi fidati per R0, vuota = nessuno)
# ODYSSEUS_PC_MAPPA_ETA_MAX_S=30 (da misurare)
