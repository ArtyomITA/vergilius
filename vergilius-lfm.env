# Vergilius — profilo per LFM2.5-2.6B (Liquid AI)
# ============================================================================
# Caricato dal boot DOPO vergilius.env e vergilius-hardware.env quando in vergilius.env c'e'
# `VERGILIUS_MODELLO=lfm`. Sovrascrive le leve tarate sul modello precedente: LFM sceglie bene gli strumenti e
# obbedisce alla lettera, quindi i vincoli scritti per il modello precedente diventano rinunce e tempo perso.
#
# Misure (19 set 2026, GTX 1080, D:\vergilius-lab\ricerche\opt-1080\misure\onda4):
#   LH1 tutti i controlli: 48/48 con strumento, ma rilancio su 9 calcoli su 12, 4 rinunce.
#   LP0 controlli spenti: 21/21 con strumento, 4/4 calcoli giusti, 0 rinunce.
#   Suite lunga 4x5 turni: L1 (questo profilo) mediana 45 s, 15,4 min, 30 chiamate;
#   L2 (stesso, con [state], 3 nudge forzati e nota tracce accesi) 57 s, 21,0 min, 38 chiamate,
#   stessi esiti turno per turno. I vincoli nascosti costano il 27% di tempo e non comprano nulla.

# --- Spenti: LFM regge da solo ------------------------------------------------
ODYSSEUS_TOOLSET_FREEZE=0
ODYSSEUS_GROUNDING_RULES=0
ODYSSEUS_GROUNDING_RETRY=0
ODYSSEUS_STATE_REMINDER=0
ODYSSEUS_TRACE_HINT=0

# --- Allentati ----------------------------------------------------------------
# Nudge «hai scritto che chiami lo strumento ma non l'hai chiamato»: uno per turno, CON chiamata
# forzata al giro dopo. Liquid stessa lo prescrive negli harness (Hermes: tool_use_enforcement)
# perche' LFM a volte descrive l'azione invece di farla; visto da noi nel turno S2.4 della suite
# lunga, dove il nudge non era scattato: la risposta era di 664 caratteri e la soglia 400.
ODYSSEUS_INTENT_NUDGE_MAX=1
ODYSSEUS_INTENT_NUDGE_FORCE=1
ODYSSEUS_INTENT_NUDGE_MAX_CHARS=1200
# Rete del futuro ("chiamero' fin_mercati", "utilizzero'"): riaccesa il 27 set. Le promesse di
# LFM sono al futuro ("Chiamero' fin_mercati" in S2.4 e nel caso Mar Nero) e la lista frasi non
# le prende, quindi senza questa leva la soglia a 1200 non serviva a nulla. Era spenta perche' la
# regex vecchia prendeva gli aggettivi in -ero e la prima corrispondenza del testo. Ora conta
# l'ultima promessa, in coda, solo con l'accento o l'apostrofo: su 497 risposte finali salvate
# (DB dal 19 set piu' suite lunga, allucinazioni e P8) 2 scatti, tutti e 2 promesse vere, contro
# 15 scatti di cui 13 falsi con la regex vecchia. Costo atteso: un giro in piu' ogni ~250 turni.
ODYSSEUS_INTENT_NUDGE_FUTURO=1
# Tool call vuota (marcatori senza nome di funzione: segnalata dalla comunita' dopo 5+ giri di
# strumenti): un solo rilancio per turno invece di chiudere il turno a vuoto.
ODYSSEUS_EMPTY_TOOLCALL_RETRY=1
# Browser: dopo 2 errori di fila degli strumenti semplici, l'harness sblocca da solo la categoria
# Playwright adatta per il giro dopo (mai tutti e 40 gli strumenti, mai il codice arbitrario).
ODYSSEUS_BROWSER_AUTO_ESCALATION=1
# Budget di pensiero nei giri con strumenti. Dal 27 set 2026 e' solo una rete contro i
# ragionamenti infiniti, non piu' un taglio: decisione del proprietario dopo il caso Mar Nero.
# Misure: dal riavvio del 26 set 142 giri su 278 (51%) finivano su "Enough thinking. Act now.",
# in 95 messaggi su 127, e il taglio cadeva sempre sulla scelta dello strumento. La prova ABBA
# del punto 8 (27 set, pensiero ridotto nei giri di routine) ha mostrato cosa costa tagliarlo:
# 3 risposte in inglese su 60 contro 0 (LFM sceglie la lingua nel pensiero) e un giro che ha
# rifatto le stesse 5 chiamate dopo "Act now".
# Decode misurato 93,6 tok/s: 2048 token sono circa 22 s nel caso peggiore di un giro.
# Storia: 128 per il modello precedente, poi 256 (senza budget LP0 passava da 30 a 40 s di mediana).
ODYSSEUS_TOOL_ROUND_REASONING_BUDGET=2048
# Modalita' voce/live: budget di pensiero su TUTTI i giri, non solo su quelli con
# gli strumenti. Vale solo quando il browser dichiara il turno vocale (microfono in
# diretta acceso); vuoto o 0 = nessun budget. Era 96 perche' il testo dentro <think>
# non si legge e la voce resta muta finche' il pensiero non finisce; dal 27 set e' anche
# qui solo una rete (stesse misure qui sopra): la voce aspetta il pensiero intero, al
# massimo circa 22 s, invece di rispondere tagliata o in inglese.
ODYSSEUS_VOICE_REASONING_BUDGET=2048
# Prefill a 1900 tok/s: gli output degli strumenti possono restare quasi interi. Storia > turno.
ODYSSEUS_TOOL_OUTPUT_CHARS=8000
ODYSSEUS_HISTORY_TOOL_CHARS=8800
# Regole di profilo Financial/OSINT senza MUST/NEVER/ZERO (stessi fatti, 1957 caratteri contro 3365).
VERGILIUS_REGOLE_PROFILO=libere
# Streaming anche nei giri con gli schemi attaccati. La leva era nata quando llama.cpp
# in streaming perdeva le tool call dei modelli con thinking; su b10549 + lfm non succede
# piu'. Misurato il 20 set 2026 con una chiamata diretta a 8012 (uno schema finto,
# "What is the price of NVDA right now?"): 59 frame di delta fra 1,80 s e 2,69 s (il
# pensiero scorre), 5 frame `delta.tool_calls` che ricompongono
# {"titolo":"NVDA"} con id e nome interi, e `timings` presente nell'ultimo frame
# (predicted_per_second 79,84) — cioe' anche le metriche tornano vere.
ODYSSEUS_LOCAL_TOOLS_NONSTREAM=0

# --- Restano da vergilius.env (non ripetute qui) ------------------------------
# HISTORY_REPLAY, MEMORY_TAIL, AGENT_MAX_TOKENS_CAP=4096, GROUNDING_CHECK=1 (solo log),
# FRESH_REQUIRED (in discussione: vedi esiti S2.4 della suite lunga), slot pin/erase dal profilo hardware.
